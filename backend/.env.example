# Backend payment credential and email verification secrets.
# Store real values in Codespaces Secrets or your production secret manager.
# Never commit a populated .env file.
RESEND_API_KEY=
PAYMENT_OTP_FROM=
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
PAYMENT_OTP_PEPPER=

# Public frontend origin used for Paystack payment return URLs.
# Set this to the exact HTTPS origin of the running frontend in Codespaces/production.
FRONTEND_ORIGIN=
